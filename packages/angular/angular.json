{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "elements-angular": {
      "projectType": "library",
      "root": "projects/elements-angular",
      "sourceRoot": "projects/elements-angular/src",
      "prefix": "unlayer",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/elements-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/elements-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/elements-angular/tsconfig.spec.json"
            "runner": "vitest",
            "buildTarget": "elements-angular::development"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "elements-angular:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/elements-angular"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "configDir": ".storybook",
            "browserTarget": "elements-angular:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/elements-angular"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}