{
  "name": "@unlayer/angular-elements",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build elements-angular",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --code-coverage",
    "storybook": "ng run elements-angular:storybook",
    "build-storybook": "ng run elements-angular:build-storybook"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "exports": "./dist/elements-angular",
  "types": "./dist/elements-angular/index.d.ts",
  "files": [
    "dist/elements-angular"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist/elements-angular"
  },
  "dependencies": {
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "unlayer-types": "^1.289.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.0",
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.0",
    "@compodoc/compodoc": "^1.1.26",
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/angular": "^9.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ng-packagr": "^20.1.0",
    "storybook": "^9.1.1",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4",
    "zone.js": "~0.15.0"
  }
}
