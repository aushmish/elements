{
  "name": "@unlayer/preact-elements",
  "version": "0.0.0",
  "description": "Preact components for building emails, pages, and documents with Unlayer Elements",
  "license": "MIT",
  "author": "Unlayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlayer/elements.git",
    "directory": "packages/preact"
  },
  "homepage": "https://github.com/unlayer/elements",
  "sideEffects": false,
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "dependencies": {
    "unlayer-types": "^1.289.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/preact-vite": "^9.1.1",
    "storybook": "^9.1.1",
    "tsup": "^8.0.1",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^24.0.0",
    "@testing-library/preact": "^3.2.0",
    "preact": "^10.19.0",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
